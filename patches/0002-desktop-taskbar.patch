+  /** Windows shell: mirror background generation activity on the taskbar and
+   * announce completion through a native toast when the user is elsewhere. */
+  const backgroundTasks = rt.activeGenerations.length;
+  const backgroundTasksFinished = t("canvas.workspace.backgroundTasksFinished");
+  const taskbarBusyRef = useRef(false);
+  useEffect(() => {
+    const bridge = globalThis.window?.opendirectorDesktop;
+    if (!bridge?.setTaskProgress) return;
+    if (backgroundTasks > 0) {
+      taskbarBusyRef.current = true;
+      bridge.setTaskProgress(null, "indeterminate");
+    } else if (taskbarBusyRef.current) {
+      taskbarBusyRef.current = false;
+      bridge.setTaskProgress(null);
+      bridge.notify?.({ title: backgroundTasksFinished });
+    }
+  }, [backgroundTasks, backgroundTasksFinished]);
 
