+/**
+ * Build the undoable command batch that scaffolds `template` around the world
+ * origin. Titles, drafts and briefs are localized through `t`; the fallback
+ * label is the node kind's own name with a per-kind counter so repeated kinds
+ * stay distinct.
+ */
+export function buildTemplateCommands(
+  template: CanvasTemplate,
+  t: (key: MessageKey) => string,
+  kindLabel: (kind: CanvasNodeKind) => string,
+  origin: Point = { x: 0, y: 0 },
+): CanvasCommand[] {
+  const xs = template.steps.map((step) => step.x);
+  const ys = template.steps.map((step) => step.y);
+  // Centre the scaffold's bounding box on the origin so it lands in view on an
+  // empty canvas regardless of the template's shape.
+  const shift = {
+    x: origin.x - (Math.min(...xs) + Math.max(...xs)) / 2,
+    y: origin.y - (Math.min(...ys) + Math.max(...ys)) / 2,
+  };
+  const seen = new Map<CanvasNodeKind, number>();
+  const nodes = template.steps.map((step) => {
+    const count = (seen.get(step.kind) ?? 0) + 1;
+    seen.set(step.kind, count);
+    return createNode(step.kind, { x: step.x + shift.x, y: step.y + shift.y }, {
+      title: step.titleKey ? t(step.titleKey) : `${kindLabel(step.kind)} ${count}`,
+      ...(step.promptKey !== undefined ? { prompt: t(step.promptKey) } : {}),
+      ...(step.textKey !== undefined ? { text: t(step.textKey) } : {}),
+      ...(step.videoMode ? { settings: { videoMode: step.videoMode } } : {}),
+    });
+  });
+  const edges: CanvasEdge[] = template.links.map(([from, to]) => ({
+    id: crypto.randomUUID(),
+    source: nodes[from].id,
+    target: nodes[to].id,
+    sourceHandle: "out",
+    targetHandle: "in",
+    intent: "generation_input",
+  }));
+  return [
+    { type: "add-nodes", nodes },
+    ...edges.map((edge): CanvasCommand => ({ type: "add-edge", edge })),
+  ];
+}
