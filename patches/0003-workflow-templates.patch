+import { useEffect, useRef } from "react";
+import { useT } from "../../i18n/I18nProvider.tsx";
+import { CanvasIcon } from "../CanvasIcon";
+import { CANVAS_TEMPLATES, type CanvasTemplate } from "./templates.ts";
+import "../workspace/example/example-canvas.css";
+
+/**
+ * Workflow template picker: rows describe what a template scaffolds; picking
+ * one hands it to the caller's apply path. Reuses the example dialog's visual
+ * language so the two galleries feel like one product.
+ */
+export function TemplatePickerDialog({
+  onClose,
+  onApply,
+}: {
+  onClose: () => void;
+  onApply: (template: CanvasTemplate) => void;
+}) {
+  const t = useT();
+  const dialog = useRef<HTMLDialogElement>(null);
+
+  useEffect(() => {
+    const element = dialog.current!;
+    element.showModal();
+    return () => element.close();
+  }, []);
+
+  return (
+    <dialog
+      ref={dialog}
+      className="cw-example-dialog"
+      aria-labelledby="cw-template-title"
+      onCancel={(event) => {
+        event.preventDefault();
+        onClose();
+      }}
+      onClick={(event) => {
+        if (event.target === event.currentTarget) onClose();
+      }}
+    >
+      <header>
+        <h2 id="cw-template-title">{t("canvas.templates.dialog.title")}</h2>
+        <p>{t("canvas.templates.dialog.hint")}</p>
+      </header>
+      <ul className="cw-example-list">
+        {CANVAS_TEMPLATES.map((template) => (
+          <li key={template.id} className="cw-example-item" data-template-id={template.id}>
+            <div className="cw-example-item-heading">
+              <CanvasIcon name={template.icon} size={18} />
+              <strong>{t(template.nameKey)}</strong>
+            </div>
+            <p className="cw-example-summary">{t(template.describeKey)}</p>
+            <div className="cw-example-actions">
+              <button type="button" onClick={() => onApply(template)}>
+                {t("canvas.templates.action.apply")}
+              </button>
+            </div>
+          </li>
+        ))}
+      </ul>
+      <div className="cw-example-dialog-actions">
+        <button type="button" onClick={onClose}>
+          {t("canvas.example.action.close")}
+        </button>
+      </div>
+    </dialog>
+  );
+}
