+import {
+  createNode,
+  type CanvasCommand,
+  type CanvasEdge,
+  type CanvasNodeKind,
+  type Point,
+} from "../model.ts";
+import type { MessageKey } from "../../i18n/types";
+
+/**
+ * Workflow templates: one click scaffolds a whole production chain the way the
+ * template communities of commercial tools do — a brief, its generation nodes
+ * and the reference wiring between them. Templates are pure data; applying one
+ * is a single undoable batch command. Media stays empty: the scaffold is a
+ * starting point, never a fabricated result. Every user-visible string lives
+ * in the message catalogues.
+ */
+export interface TemplateStep {
+  kind: CanvasNodeKind;
+  /** Layout offset within the template box, in canvas units. */
+  x: number;
+  y: number;
+  /** Localized node title; falls back to the kind label. */
+  titleKey?: MessageKey;
+  /** Localized generation draft for media nodes. */
+  promptKey?: MessageKey;
+  /** Localized body text for text nodes. */
+  textKey?: MessageKey;
+  /** Multi-source video nodes are reference collages, like a batch drop. */
+  videoMode?: "reference";
+}
+
+export interface CanvasTemplate {
+  id: string;
+  icon: string;
+  nameKey: MessageKey;
+  describeKey: MessageKey;
+  steps: TemplateStep[];
+  /** Step index pairs wired as generation references (from → to). */
+  links: Array<[number, number]>;
+}
+
