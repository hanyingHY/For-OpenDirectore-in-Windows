diff --git a/src/canvas/AssistantRoundChanges.tsx b/src/canvas/AssistantRoundChanges.tsx
new file mode 100644
index 00000000..424f6cec
--- /dev/null
+++ b/src/canvas/AssistantRoundChanges.tsx
@@ -0,0 +1,81 @@
+import { useEffect, useState } from "react";
+import { roundChanges, undoRound, type RoundChanges } from "../backend/roundChanges";
+import type { Translate } from "../i18n/I18nProvider.tsx";
+
+/**
+ * Round review under a finished Agent reply: how many canvas writes the turn made,
+ * and a two-step "undo this round" that never overwrites a later edit.
+ */
+export function AssistantRoundChanges({
+  documentId,
+  turnId,
+  busy,
+  onUndone,
+  t,
+}: {
+  documentId: string;
+  turnId: string;
+  /** True while the turn or any other Agent run is still active: review waits for it to finish. */
+  busy: boolean;
+  onUndone: () => void;
+  t: Translate;
+}) {
+  const [round, setRound] = useState<RoundChanges | null>(null);
+  const [confirming, setConfirming] = useState(false);
+  const [pending, setPending] = useState(false);
+  const [notice, setNotice] = useState<{ tone: "ok" | "error"; text: string } | null>(null);
+
+  useEffect(() => {
+    if (busy) return;
+    const abort = new AbortController();
+    roundChanges(documentId, turnId, abort.signal)
+      .then(setRound)
+      .catch(() => setRound(null));
+    return () => abort.abort();
+  }, [documentId, turnId, busy]);
+
+  if (!round || round.items.length === 0) return null;
+  const count = round.undoable;
+  if (count === 0 && !notice) return null;
+
+  const undo = async () => {
+    setPending(true);
+    setConfirming(false);
+    try {
+      const result = await undoRound(documentId, turnId);
+      const rejected = result.results.find((item) => item.status === "rejected");
+      setRound(result);
+      setNotice(
+        result.complete
+          ? { tone: "ok", text: t("assistant.round.undone", { count: result.results.length }) }
+          : { tone: "error", text: rejected?.message ?? t("assistant.round.partial") },
+      );
+      onUndone();
+    } catch (failure) {
+      setNotice({ tone: "error", text: failure instanceof Error ? failure.message : t("assistant.round.failed") });
+    } finally {
+      setPending(false);
+    }
+  };
+
+  return (
+    <div className="cw-chat-round-changes" data-state={notice?.tone ?? "pending"}>
+      {count > 0 && (
+        <span className="cw-chat-round-summary">{t("assistant.round.summary", { count })}</span>
+      )}
+      {count > 0 && !confirming && (
+        <button type="button" disabled={busy || pending} onClick={() => setConfirming(true)}>
+          {t("assistant.round.undo")}
+        </button>
+      )}
+      {count > 0 && confirming && (
+        <>
+          <span>{t("assistant.round.confirm", { count })}</span>
+          <button type="button" onClick={() => void undo()} disabled={pending}>{t("assistant.round.confirmUndo")}</button>
+          <button type="button" onClick={() => setConfirming(false)}>{t("assistant.round.cancel")}</button>
+        </>
+      )}
+      {notice && <p role="status">{notice.text}</p>}
+    </div>
+  );
+}
