+++ b/src/backend/roundChanges.ts
@@ -0,0 +1,32 @@
+import { json, request } from "./api.ts";
+
+/** One Agent write of a turn, as recorded in the round ledger. */
+export interface RoundChange {
+  commandId: string;
+  type: string;
+  cursor: number;
+  state: "applied" | "undone" | "unavailable";
+  changed: { objectType: string; id: string }[];
+}
+
+export interface RoundChanges {
+  turnId: string;
+  items: RoundChange[];
+  undoable: number;
+}
+
+export interface RoundUndoResult extends RoundChanges {
+  results: { commandId: string; status: string; message?: string }[];
+  complete: boolean;
+}
+
+const roundPath = (projectId: string, turnId: string) =>
+  `/creation/projects/${projectId}/assistant/turns/${turnId}`;
+
+/** Read-only review of the Agent writes of one turn. */
+export const roundChanges = (projectId: string, turnId: string, signal?: AbortSignal) =>
+  request<RoundChanges>(roundPath(projectId, turnId) + "/changes", { signal });
+
+/** Undo every still-applied write of the turn, newest first; stops at the first conflict. */
+export const undoRound = (projectId: string, turnId: string) =>
+  request<RoundUndoResult>(roundPath(projectId, turnId) + "/undo", json("POST", {}));
