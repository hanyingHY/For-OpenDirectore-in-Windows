diff --git a/packages/core/src/opendirector/application/agent_rounds.py b/packages/core/src/opendirector/application/agent_rounds.py
new file mode 100644
index 00000000..9987349e
--- /dev/null
+++ b/packages/core/src/opendirector/application/agent_rounds.py
@@ -0,0 +1,111 @@
+"""Per-turn change ledger for Agent writes: review a round and undo it as one unit.
+
+Every Agent command that lands as an undoable project edit is appended to
+``agent-runs/<turn>.changes.jsonl`` with its project event cursor. Review reads the
+ledger joined with the authoritative history states; undo replays ``history.undo``
+through the normal command path, newest first, so the existing field-level conflict
+checks still protect any edit the user made afterwards. The first rejected step stops
+the round: nothing is overwritten silently and partial progress is reported.
+"""
+import json
+from uuid import UUID, uuid5
+
+from opendirector.application.creation_history import CreationHistory, UNDOABLE
+from opendirector.domain.creation.commands import parse_command
+from opendirector.domain.creation.validation import ContractError
+from opendirector.domain.projects import ProjectError
+from opendirector.infrastructure.local_projects import child
+
+LEDGER_SUFFIX = '.changes.jsonl'
+
+
+def ledger_path(projects, project_id: UUID, turn_id: UUID):
+    with projects.local.transaction() as db:
+        project_directory, _, _ = projects._load(db, project_id)
+    return child(child(project_directory, 'agent-runs'), f'{turn_id}{LEDGER_SUFFIX}')
+
+
+def record_change(projects, project_id: UUID, turn_id: UUID, call_id: str, command_type: str, receipt) -> None:
+    """Append one applied, undoable Agent command. Called after the command committed."""
+    if command_type not in UNDOABLE or getattr(receipt, 'status', None) != 'applied':
+        return
+    cursor = getattr(receipt, 'eventCursor', None)
+    if not isinstance(cursor, int) or cursor < 1:
+        return
+    changed = [dict(objectType=item.objectType, id=str(item.id)) for item in getattr(receipt, 'changed', ())]
+    entry = dict(commandId=str(receipt.commandId), callId=call_id, type=command_type, cursor=cursor, changed=changed)
+    file = ledger_path(projects, project_id, turn_id)
+    file.parent.mkdir(parents=True, exist_ok=True)
+    with file.open('a', encoding='utf-8') as stream:
+        stream.write(json.dumps(entry, ensure_ascii=False) + '\n')
+
+
+def read_ledger(projects, project_id: UUID, turn_id: UUID) -> list[dict]:
+    file = ledger_path(projects, project_id, turn_id)
+    if not file.is_file():
+        return []
+    entries = []
+    for line in file.read_text(encoding='utf-8').splitlines():
+        if line.strip():
+            entries.append(json.loads(line))
+    return sorted(entries, key=lambda item: item['cursor'])
+
+
+def round_changes(projects, project_id: UUID, turn_id: UUID) -> dict:
+    entries = read_ledger(projects, project_id, turn_id)
+    states = {str(item['commandId']): item['state'] for item in CreationHistory(projects).operations(project_id)}
+    items = [dict(commandId=item['commandId'], type=item['type'], cursor=item['cursor'],
+                  changed=item.get('changed', []), state=states.get(item['commandId'], 'unavailable')) for item in entries]
+    return dict(turnId=str(turn_id), items=items,
+                undoable=sum(1 for item in items if item['state'] == 'applied'))
+
+
+# Collections that hold the business objects a history record can name.
+_VERSION_COLLECTIONS = {
+    'project': None, 'asset': 'assets', 'generation_spec': 'generationSpecs', 'reference': 'references',
+    'canvas_item': 'canvasItems', 'editor_document': 'editorDocuments', 'job': 'jobs', 'result': 'results',
+}
+
+
+def current_versions(snapshot, changed: list[dict]) -> list[dict]:
+    """Current revisions of the objects a change touched. The field-level history check still decides conflicts."""
+    versions = []
+    for ref in changed:
+        collection = _VERSION_COLLECTIONS.get(ref['objectType'])
+        if collection is None:
+            continue
+        for value in getattr(snapshot, collection):
+            if str(value.id) == ref['id']:
+                versions.append(dict(objectType=ref['objectType'], id=ref['id'], revision=value.revision))
+                break
+    return versions
+
+
+def undo_round(projects, project_id: UUID, turn_id: UUID, session: str) -> dict:
+    """Undo every still-applied change of one turn, newest first. Stops at the first rejection."""
+    changes = round_changes(projects, project_id, turn_id)
+    pending = [item for item in reversed(changes['items']) if item['state'] == 'applied']
+    results = []
+    for item in pending:
+        snapshot = projects.snapshot(project_id)
+        command = parse_command({
+            'type': 'history.undo',
+            'projectId': str(project_id),
+            'commandId': str(uuid5(turn_id, f"undo:{item['commandId']}")),
+            'expectedVersions': current_versions(snapshot, item['changed']),
+            'payload': {'targetCommandId': item['commandId']},
+        })
+        try:
+            receipt = projects.execute(command, session=session, source='ui')
+        except (ProjectError, ContractError) as failure:
+            results.append(dict(commandId=item['commandId'], status='rejected', message=str(failure)))
+            break
+        status = getattr(receipt, 'status', 'applied')
+        issues = getattr(receipt, 'issues', ())
+        results.append(dict(commandId=item['commandId'], status=status,
+                            **({'message': issues[0].message} if status == 'rejected' and issues else {})))
+        if status == 'rejected':
+            break
+    remaining = round_changes(projects, project_id, turn_id)
+    return dict(turnId=str(turn_id), results=results, items=remaining['items'], undoable=remaining['undoable'],
+                complete=remaining['undoable'] == 0 and all(r['status'] != 'rejected' for r in results))
