+def test_live_run_holds_rename_trash_and_cleanup_until_it_ends(workspace, monkeypatch):
+    client, root, path, home = workspace['client'], workspace['root'], workspace['path'], workspace['home']
+    pid = root.rsplit('/', 1)[-1]
+    started, release = threading.Event(), threading.Event()
+
+    async def stream(self, run):
+        started.set()
+        await asyncio.to_thread(release.wait, 10)
+        yield {'type': 'delta', 'text': '完成'}
+
+    def command(kind, payload=None):
+        revision = client.get(root, headers=window()).json()['project']['revision']
+        versions = [{'objectType': 'project', 'id': pid, 'revision': revision}]
+        return {'type': kind, 'projectId': pid, 'commandId': str(uuid4()), 'payload': payload or {}, 'expectedVersions': versions}
+
+    monkeypatch.setattr(agent.AgentRuntimes, 'stream', stream)
+    with ThreadPoolExecutor() as pool:
+        pending = pool.submit(client.post, path + '/turns', json={'id': str(uuid4()), 'runtime': 'default', 'text': '占用'}, headers=home)
+        assert started.wait(5)
+        assert client.delete(f'/api/creation/sessions/{home["X-OpenDirector-Session"]}').status_code == 200
+        # The run's own row is the only one left; it counts as an open holder for every destructive path.
+        with workspace['projects'].local.transaction() as db:
+            run_path = db.execute("SELECT path FROM sessions WHERE owner<>''").fetchone()['path']
+            assert db.execute("SELECT COUNT(*) FROM sessions WHERE owner<>''").fetchone()[0] == 1
+        renamed = client.post(root + '/commands', json=command('project.rename', {'name': '改名'}), headers=window())
+        assert renamed.status_code == 409, renamed.text
+        trashed = client.post(root + '/commands', json=command('project.trash'), headers=window())
+        assert trashed.status_code == 409, trashed.text
+        with workspace['projects'].local.transaction() as db:
+            blocker = ProjectCatalog._cleanup_blocker(db, pid, Path(run_path))
+        assert blocker and '其他窗口' in blocker
+        release.set()
+        assert frames(pending.result(timeout=10))[-1]['error'] is None
+    # Once the run ends its row is gone and the project can be renamed again.
+    with workspace['projects'].local.transaction() as db:
+        assert db.execute("SELECT COUNT(*) FROM sessions WHERE owner<>''").fetchone()[0] == 0
+        assert ProjectCatalog._cleanup_blocker(db, pid, Path(run_path)) is None
+    # Rename needs every holder gone; the window already left the project, so only the run blocked it.
+    renamed = client.post(root + '/commands', json=command('project.rename', {'name': '改名'}), headers=window())
+    assert renamed.status_code == 200, renamed.text
