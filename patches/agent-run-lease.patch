+"""RFC #362 B2: an Agent run holds its own project lease.
+
+The window that starts a reply may switch projects, close, or let its heartbeat
+lapse; the reply keeps its writes, other windows are still kept out, and Stop
+works from any window.
+"""
+import asyncio
+from concurrent.futures import ThreadPoolExecutor
+import json
+import sqlite3
+import threading
