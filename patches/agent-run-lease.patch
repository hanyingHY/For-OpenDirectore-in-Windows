+def test_stop_works_from_a_window_that_is_on_another_project(workspace, monkeypatch):
+    client, path, home = workspace['client'], workspace['path'], workspace['home']
+    started = threading.Event()
+
+    async def stream(self, run):
+        yield {'type': 'delta', 'text': '保留部分回复'}
+        started.set()
+        await asyncio.sleep(10)  # Stop cancels this; the bound keeps a failing run from hanging.
+
+    monkeypatch.setattr(agent.AgentRuntimes, 'stream', stream)
+    turn = str(uuid4())
+    with ThreadPoolExecutor() as pool:
+        pending = pool.submit(client.post, path + '/turns', json={'id': turn, 'runtime': 'default', 'text': '等待'}, headers=home)
+        assert started.wait(5)
+        assert client.delete(f'/api/creation/sessions/{home["X-OpenDirector-Session"]}').status_code == 200
+        stopped = client.post(path + f'/turns/{turn}/stop', headers=window())
+        assert stopped.status_code == 200, stopped.text
+        assert pending.result(timeout=5).status_code == 200
+    assert client.get(path).json()['messages'][-1]['status'] == 'stopped'
+
