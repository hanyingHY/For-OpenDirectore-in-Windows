+        assert client.post(root + '/commands', json={'type': 'project.create', 'projectId': pid,
+            'commandId': str(uuid4()), 'payload': {'name': '租约'}}).status_code == 200
+        assert client.post(root + '/open').status_code == 200
+        yield dict(client=client, root=root, path=root + '/assistant', home=home, tmp_path=tmp_path,
+                   projects=CreationProjects(LocalProjects(tmp_path)))
+
+
+def run_write(projects, name):
+    """An Agent tool write, as the gateway issues it: through the run's own session."""
+    async def write(run):
+        command = parse_command(dict(type='asset.writeText', commandId=str(uuid4()), projectId=str(run.project_id),
+                                     payload=dict(name=name, text='agent text')))
+        await asyncio.to_thread(projects.execute, command, session=run.session, source='agent')
+    return write
+
+
+def test_run_keeps_writing_after_its_window_switches_projects(workspace, monkeypatch):
+    client, root, path, home = workspace['client'], workspace['root'], workspace['path'], workspace['home']
+    started, release = threading.Event(), threading.Event()
+    written = []
+
+    async def stream(self, run):
+        started.set()
+        await asyncio.to_thread(release.wait, 10)
+        await run_write(workspace['projects'], '灯光.md')(run)
+        written.append(run.session)
+        yield {'type': 'delta', 'text': '完成'}
+
+    monkeypatch.setattr(agent.AgentRuntimes, 'stream', stream)
+    with ThreadPoolExecutor() as pool:
+        turn = str(uuid4())
+        pending = pool.submit(client.post, path + '/turns', json={'id': turn, 'runtime': 'default', 'text': '写'}, headers=home)
+        assert started.wait(5)
+        # The window moves on: it releases project A's lease, as a project switch does.
+        assert client.delete(f'/api/creation/sessions/{home["X-OpenDirector-Session"]}').status_code == 200
+        release.set()
+        final = frames(pending.result(timeout=10))[-1]
+    assert final['error'] is None, final
+    assets = client.get(root + '/assets').json()
+    assert any(asset['name'] == '灯光.md' for asset in assets)
+    # The run wrote under its own lease, not the window's.
+    assert written and written[0] != home['X-OpenDirector-Session']
+
