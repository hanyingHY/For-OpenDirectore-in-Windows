+        await asyncio.to_thread(release.wait, 10)
+        yield {'type': 'delta', 'text': '完成'}
+
+    monkeypatch.setattr(agent.AgentRuntimes, 'stream', stream)
+    with ThreadPoolExecutor() as pool:
+        pending = pool.submit(client.post, path + '/turns', json={'id': str(uuid4()), 'runtime': 'default', 'text': '写'}, headers=home)
+        assert started.wait(5)
+        assert client.delete(f'/api/creation/sessions/{home["X-OpenDirector-Session"]}').status_code == 200
+        # Another window cannot open the project while the run holds it.
+        other = client.post(root + '/open', headers=window())
+        assert other.status_code == 409
+        assert other.json()['code'] == 'project_open_elsewhere'
