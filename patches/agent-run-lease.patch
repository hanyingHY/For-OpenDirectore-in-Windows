+def test_run_keeps_other_windows_out_and_its_own_window_back_in(workspace, monkeypatch):
+    client, root, path, home = workspace['client'], workspace['root'], workspace['path'], workspace['home']
+    started, release = threading.Event(), threading.Event()
+
+    async def stream(self, run):
