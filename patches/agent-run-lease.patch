+def test_catalog_from_before_run_leases_gains_the_owner_column(tmp_path):
+    local = LocalProjects(tmp_path)
+    with sqlite3.connect(local.database) as db:
+        db.execute('DROP TABLE sessions')
+        db.execute("CREATE TABLE sessions (id TEXT PRIMARY KEY, project_id TEXT NOT NULL, expires REAL NOT NULL, path TEXT NOT NULL DEFAULT '')")
+        db.execute("INSERT INTO sessions VALUES (?,?,?,?)", (str(uuid4()), str(uuid4()), 9e12, '/p'))
+    LocalProjects(tmp_path)
+    with sqlite3.connect(local.database) as db:
+        columns = [row[1] for row in db.execute('PRAGMA table_info(sessions)')]
+        assert 'owner' in columns
+        assert db.execute("SELECT owner FROM sessions").fetchall() == [('',)]
