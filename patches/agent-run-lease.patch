+def test_run_lease_outlives_the_window_lease_and_is_released_at_the_end(workspace, monkeypatch):
+    client, root, path, home = workspace['client'], workspace['root'], workspace['path'], workspace['home']
+    monkeypatch.setattr(LocalProjects, 'LEASE_SECONDS', 0.5)
+    # Re-open so the window's own lease is also short-lived (the fixture used the default).
+    assert client.post(root + '/open', headers=home).status_code == 200
+    started = threading.Event()
+
+    async def stream(self, run):
+        started.set()
+        # Longer than a window lease: a lapsed heartbeat must not cut the run off.
+        await asyncio.sleep(1.2)
+        await run_write(workspace['projects'], '长回复.md')(run)
+        yield {'type': 'delta', 'text': '完成'}
+
+    monkeypatch.setattr(agent.AgentRuntimes, 'stream', stream)
+    with ThreadPoolExecutor() as pool:
+        pending = pool.submit(client.post, path + '/turns', json={'id': str(uuid4()), 'runtime': 'default', 'text': '长'}, headers=home)
+        assert started.wait(5)
+        # No window heartbeat: only the run keeps the project.
+        final = frames(pending.result(timeout=10))[-1]
+    assert final['error'] is None, final
+    assert any(asset['name'] == '长回复.md' for asset in client.get(root + '/assets').json())
+    with workspace['projects'].local.transaction() as db:
+        assert db.execute("SELECT COUNT(*) FROM sessions WHERE owner<>''").fetchone()[0] == 0
+
