new file mode 100644
index 0000000..6ad7494
--- /dev/null
+++ b/packages/core/src/opendirector/agent/bundled_profile.py
@@ -0,0 +1,18 @@
+"""Storage for OpenDirector’s managed OpenCode, not the user’s standalone CLI."""
+import os
+from pathlib import Path
+
+from opendirector.installation import data_root
+
+
+def bundled_profile() -> Path:
+    home = os.environ.get('OPENDIRECTOR_BUNDLED_AGENT_HOME')
+    base = Path(home) if home else data_root() / '.opendirector' / 'agent-runtime'
+    # This is a storage compatibility epoch, not the desktop release number.
+    return base.resolve() / 'opencode-v1'
+
+
+def bundled_environment(config: Path) -> dict[str, str]:
+    profile = bundled_profile()
+    return {'XDG_CONFIG_HOME': str(config),
+            **{f'XDG_{key.upper()}_HOME': str(profile / key) for key in ('data', 'cache', 'state')}}
