+import type { CanvasNode, Point, Rect } from "./model.ts";
+import { absolutePositionFromIndex } from "./geometry.ts";
+import { indexNodes } from "./hierarchy.ts";
+
+// Find the ends of the connected run of forbidden positions containing p.
+// Open endpoints are legal: exactly gap units of clearance is enough.
+function exits(p: number, intervals: [number, number][]): number[] {
+  intervals.sort((a, b) => a[0] - b[0]);
+  let lo = Infinity, hi = -Infinity;
+  for (const [a, b] of intervals) {
+    if (a >= hi) {
+      if (lo < p && p < hi) return [hi, lo];
+      lo = a; hi = b;
+    } else hi = Math.max(hi, b);
+  }
+  return lo < p && p < hi ? [hi, lo] : [p];
+}
+
+/** Place automatic additions only. Positions are top-left document coordinates,
+ * independent of CSS transforms, monitor DPI, camera zoom and animation.
+ * Try the nearest clear position along four axes; no arbitrary search radius.
+ * Keep the original position if clear. Never move an existing node. */
+export function freePosition(preferred: Rect, occupied: readonly Rect[], gap = 64): Point {
+  const {x, y, width, height} = preferred;
+  const xs: [number, number][] = [], ys: [number, number][] = [];
+  for (const r of occupied) {
+    const left = r.x - width - gap, right = r.x + r.width + gap;
+    const top = r.y - height - gap, bottom = r.y + r.height + gap;
+    if (top < y && y < bottom) xs.push([left, right]);
+    if (left < x && x < right) ys.push([top, bottom]);
+  }
+  const candidates = [...exits(x, xs).map(nx => ({x: nx, y})),
+                      ...exits(y, ys).map(ny => ({x, y: ny}))];
+  const distance = (p: Point) => Math.abs(p.x - x) + Math.abs(p.y - y);
+  return candidates.reduce((best, p) => distance(p) < distance(best) ? p : best);
+}
+
+export function placeAutomaticNodes(existing: readonly CanvasNode[], additions: CanvasNode[]) {
+  const byId = indexNodes(existing);
+  const occupied = existing.map(n => ({...absolutePositionFromIndex(n, byId), width:n.width, height:n.height}));
+  for (const n of additions) {
+    n.position = freePosition({...n.position, width:n.width, height:n.height}, occupied);
+    occupied.push({...n.position, width:n.width, height:n.height});
+  }
+  return additions;
+}
