# RFC #362 desktop.15 · C11 (Windows distribution patch, also valid upstream):
# the H.264 encode failure names a concrete next step instead of a dead end.
#
#  * The existing copy already says why the MP4 render cannot start (no
#    WebCodecs at this size, Windows N/KN Media Feature Pack). This patch adds
#    the fallback path to the same message: keep the timeline with Export
#    JSON / editable bundle and render later where WebCodecs is available.
#  * Copy-only change: no tests assert this string, i18n key count unchanged
#    (3287 keys, 0 problems).
#
diff --git a/src/i18n/messages/en-US/errors.ts b/src/i18n/messages/en-US/errors.ts
index 53f39dcf..f0e957d5 100644
--- a/src/i18n/messages/en-US/errors.ts
+++ b/src/i18n/messages/en-US/errors.ts
@@ -775,7 +775,7 @@ export const errors = {
   "errors.render.mp4Even":
     "MP4 width and height must be even. Adjust the timeline size.",
   "errors.render.mp4H264":
-    "This browser cannot encode H.264 at this size. Use a browser with WebCodecs support or reduce the size. On Windows N/KN editions, install the Media Feature Pack first, then restart the app.",
+    "This browser cannot encode H.264 at this size. Use a browser with WebCodecs support or reduce the size. On Windows N/KN editions, install the Media Feature Pack first, then restart the app. To keep the timeline meanwhile, use Export JSON / editable bundle and render it later where WebCodecs is available.",
   "errors.render.aac":
     "Could not initialize AAC audio encoding. Reopen the page and try again. On Windows N/KN editions, install the Media Feature Pack first.",
   "errors.render.noFile": "Video encoding did not return a file.",
diff --git a/src/i18n/messages/zh-CN/errors.ts b/src/i18n/messages/zh-CN/errors.ts
index 953397bf..0f254bbf 100644
--- a/src/i18n/messages/zh-CN/errors.ts
+++ b/src/i18n/messages/zh-CN/errors.ts
@@ -584,7 +584,7 @@ export const errors = {
   "errors.render.mp4Invalid": "导出时长或帧率无效。",
   "errors.render.mp4Even": "MP4 的宽度与高度需要为偶数，请调整时间线尺寸。",
   "errors.render.mp4H264":
-    "当前浏览器无法编码此尺寸的 H.264，请换用支持 WebCodecs 的浏览器或降低尺寸。Windows N/KN 版本请先安装「媒体功能包 / Media Feature Pack」后重启应用。",
+    "当前浏览器无法编码此尺寸的 H.264，请换用支持 WebCodecs 的浏览器或降低尺寸。Windows N/KN 版本请先安装「媒体功能包 / Media Feature Pack」后重启应用。导出前可先用「导出 JSON / 可编辑包」保留时间线，之后导入支持 WebCodecs 的环境继续渲染。",
   "errors.render.aac":
     "无法初始化 AAC 音频编码，请重新打开页面后重试。Windows N/KN 版本请先安装「媒体功能包 / Media Feature Pack」。",
   "errors.render.noFile": "视频编码没有返回文件。",
