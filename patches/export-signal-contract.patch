diff --git a/src/canvas/exportSignal.ts b/src/canvas/exportSignal.ts
new file mode 100644
index 0000000..f6e4bc3
--- /dev/null
+++ b/src/canvas/exportSignal.ts
@@ -0,0 +1,59 @@
+/** Explicit "an export or render is in flight" signal for the desktop host.
+ *
+ * The Windows host must know when rendering is running (quit confirmation,
+ * tray busy state). Reading UI class names from the host couples that decision
+ * to presentation details that can be renamed at any time. Instead the app
+ * publishes one contract: while at least one export/render is in flight the
+ * document element carries `data-od-exporting`; when none is, the attribute is
+ * absent. Hosts read the attribute first and may keep a class-based fallback
+ * for older bundles. Electron-style shells that expose
+ * `window.opendirectorDesktop.setExporting` also receive the transitions.
+ *
+ * The signal is refcounted: overlapping exports (several timelines, a media
+ * editor render beside a timeline output) must not clear it early. */
+import { useEffect } from "react";
+
+let inFlight = 0;
+
+declare global {
+  interface Window {
+    opendirectorDesktop?: { setExporting?(active: boolean): void };
+  }
+}
+
+function publish() {
+  const active = inFlight > 0;
+  if (active) document.documentElement.setAttribute("data-od-exporting", "");
+  else document.documentElement.removeAttribute("data-od-exporting");
+  try {
+    globalThis.window?.opendirectorDesktop?.setExporting?.(active);
+  } catch {
+    /* A host bridge is optional; the attribute is the contract. */
+  }
+}
+
+/** Mark the start of an export/render. Returns its exact end marker. */
+export function exportStarted(): () => void {
+  inFlight += 1;
+  if (inFlight === 1) publish();
+  let ended = false;
+  return () => {
+    if (ended) return;
+    ended = true;
+    inFlight -= 1;
+    if (inFlight === 0) publish();
+  };
+}
+
+/** React helper: hold the signal while mounted (or while `active` is true). */
+export function useExportSignal(active = true) {
+  useEffect(() => {
+    if (!active) return;
+    return exportStarted();
+  }, [active]);
+}
+
+/** Test seam: current in-flight count (never negative). */
+export function exportInFlight(): number {
+  return inFlight;
+}
