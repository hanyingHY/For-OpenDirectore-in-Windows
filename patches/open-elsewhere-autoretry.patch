@@ -189,6 +189,7 @@ export function WorkspaceView({ rt }: { rt: WorkspaceRuntime }) {
     importInput,
     importLibrarySubjects,
     initializationError,
+    openElsewhereWait,
     insertLibraryItems,
     installDocument,
     interacting,
@@ -2984,6 +2985,19 @@ export function WorkspaceView({ rt }: { rt: WorkspaceRuntime }) {
               <button onClick={() => window.location.reload()}>{t("canvas.workspace.loading.reconnect")}</button>
               <a href="/">{t("canvas.workspace.loading.backHome")}</a>
             </div>
+          ) : openElsewhereWait > 0 ? (
+            <div className="canvas-loading-message canvas-loading-waiting">
+              <span className="canvas-loading-spinner" aria-hidden="true" />
+              <p>
+                {t("canvas.workspace.loading.openElsewhere", {
+                  seconds: openElsewhereWait,
+                })}
+              </p>
+              <button onClick={() => window.location.reload()}>
+                {t("canvas.workspace.loading.reconnect")}
+              </button>
+              <a href="/">{t("canvas.workspace.loading.backHome")}</a>
+            </div>
           ) : (
             <span className="canvas-loading-message">
               <span className="canvas-loading-spinner" aria-hidden="true" />
