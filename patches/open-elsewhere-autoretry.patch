index edb6be8..134d07d 100644
--- a/src/canvas/workspace/useWorkspaceDocument.ts
+++ b/src/canvas/workspace/useWorkspaceDocument.ts
@@ -2,7 +2,7 @@
 import { pinnedReferenceAssets } from "../pinnedReferenceAssets.ts";
 import { SaveQueue } from "../saveQueue.ts";
 import { useCallback, useEffect, useRef } from "react";
-import { errorMessage } from "../../backend/api.ts";
+import { errorMessage, ApiError } from "../../backend/api.ts";
 import { creationClient, CreationCommandError, itemSpec } from "../../backend/creationClient.ts";
 import { fingerprint } from "../../backend/generation.ts";
 
@@ -59,6 +59,7 @@ export function useWorkspaceDocument(rt: WorkspaceRuntime) {
     setHistory,
     setHistoryReplaying,
     setInitializationError,
+    setOpenElsewhereWait,
     setInteracting,
     setMeasurements,
     setMenu,
@@ -473,19 +474,39 @@ export function useWorkspaceDocument(rt: WorkspaceRuntime) {
 
   useEffect(() => {
     let alive = true;
-    const init = async () => {
+    let timer: number | undefined;
+    // A window closed without releasing its lease holds the project "open
+    // elsewhere" until the lease expires (up to ~60 s). A fresh window that
+    // knows it is not a duplicate waits that out with quiet retries and a
+    // countdown instead of demanding a manual reload the user can only answer
+    // by waiting anyway. Anything else fails to the error card at once.
+    const OPEN_ELSEWHERE_RETRIES = 25;
+    const init = async (attempt = 0) => {
       try {
         const document = await initializeWorkspace();
         if (!alive) return;
         installDocument(document);
+        setOpenElsewhereWait(0);
         setReady(true);
       } catch (error) {
-        if (alive) setInitializationError(errorMessage(error));
+        if (!alive) return;
+        if (
+          error instanceof ApiError &&
+          error.code === "project_open_elsewhere" &&
+          attempt < OPEN_ELSEWHERE_RETRIES
+        ) {
+          setOpenElsewhereWait((OPEN_ELSEWHERE_RETRIES - attempt) * 3);
+          timer = window.setTimeout(() => void init(attempt + 1), 3000);
+          return;
+        }
+        setOpenElsewhereWait(0);
+        setInitializationError(errorMessage(error));
       }
     };
     void init();
     return () => {
       alive = false;
+      if (timer !== undefined) window.clearTimeout(timer);
       importAbort.current?.abort();
     };
   }, [installDocument, notify]);
