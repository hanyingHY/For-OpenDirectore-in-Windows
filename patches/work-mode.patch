+import { useState } from "react";
+import { useI18n } from "../i18n/I18nProvider";
+import type { ReferenceContent } from "./chatReferenceContent";
+
+/** System presets for simple mode (desktop.14 · A1). A preset fills the composer draft; the user edits it there. */
+export const systemPresets = [
+  { id: "seaside", name: "workMode.preset.seaside", text: "workMode.presetText.seaside" },
+  { id: "product", name: "workMode.preset.product", text: "workMode.presetText.product" },
+  { id: "anime", name: "workMode.preset.anime", text: "workMode.presetText.anime" },
+  { id: "city", name: "workMode.preset.city", text: "workMode.presetText.city" },
+] as const;
+
+/** Keep non-text parts (references, skills) when a preset replaces the text. */
+export function draftWithPreset(content: ReferenceContent | null | undefined, text: string): ReferenceContent {
+  const rest = (content ?? []).filter((part) => part.type !== "text");
+  return [{ type: "text", text }, ...rest];
+}
+
+export function SimplePresetDrawer({ onPreset, onReferences }: {
+  onPreset: (text: string) => void;
+  onReferences: () => void;
+}) {
+  const { t } = useI18n();
+  const [open, setOpen] = useState(false);
+  return (
+    <div className="cw-simple-presets">
+      <button
+        type="button"
+        className="cw-simple-presets-toggle"
+        aria-expanded={open}
+        aria-controls="cw-simple-presets-drawer"
+        onClick={() => setOpen(!open)}
+      >
+        {t("workMode.presets.open")}
+      </button>
+      {open && (
+        <div className="cw-simple-presets-drawer" id="cw-simple-presets-drawer">
+          <div className="cw-simple-presets-list" role="group" aria-label={t("workMode.presets.title")}>
+            {systemPresets.map((preset) => (
+              <button
+                key={preset.id}
+                type="button"
+                className="cw-simple-preset"
+                onClick={() => onPreset(t(preset.text as never))}
+              >
+                {t(preset.name as never)}
+              </button>
+            ))}
+          </div>
+          <button type="button" className="cw-simple-presets-reference" onClick={onReferences}>
+            {t("workMode.presets.references")}
+          </button>
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/src/canvas/SimpleResultCards.tsx b/src/canvas/SimpleResultCards.tsx
new file mode 100644
index 0000000..f9bf4e0
--- /dev/null
+++ b/src/canvas/SimpleResultCards.tsx
@@ -0,0 +1,98 @@
+import { useEffect, useRef, useState } from "react";
+import { useI18n } from "../i18n/I18nProvider";
+import type { CanvasNode } from "./model";
+import "./work-mode.css";
+
+const signature = (node: CanvasNode) => `${node.data.title}\u0000${node.data.src ?? ""}`;
+
+/** desktop.15 · B'-3: after a simple-mode reply completes, show what appeared on the canvas
+ * while it ran (new or retitled nodes) so a one-sentence request visibly lands somewhere.
+ * The strip only observes the document — it never writes — and a new reply resets it.
+ * The view button hands the node to the workspace (advanced mode + focus), per the
+ * confirmed A1 spec: result cards are the bridge from the one-sentence flow into the
+ * full canvas.
+ *
+ * The pre-reply snapshot is captured during the last idle render, so no effect race can
+ * miss a change that lands immediately after the reply starts. On completion the diff
+ * waits (bounded, armed once) for the document to catch up before giving up. */
+export function SimpleResultCards({
+  nodes,
+  replyActive,
+  visible,
+  onView,
+}: {
+  nodes: CanvasNode[];
+  replyActive: boolean;
+  visible: boolean;
+  onView?: (nodeId: string) => void;
+}) {
+  const { t } = useI18n();
+  const [results, setResults] = useState<CanvasNode[]>([]);
+  const [dismissed, setDismissed] = useState(false);
+  const beforeRef = useRef<Map<string, string> | null>(null);
+  const lastIdleRef = useRef<CanvasNode[]>(nodes);
+  const expiryRef = useRef<number | undefined>(undefined);
+  if (!replyActive) lastIdleRef.current = nodes;
+  useEffect(() => {
+    if (replyActive) {
+      if (expiryRef.current !== undefined) {
+        window.clearTimeout(expiryRef.current);
+        expiryRef.current = undefined;
+      }
+      beforeRef.current = new Map(lastIdleRef.current.map((node) => [node.id, signature(node)]));
+      setResults([]);
+      setDismissed(false);
+      return;
+    }
+    const before = beforeRef.current;
+    if (!before) return;
+    const changed = nodes.filter((node) => before.get(node.id) !== signature(node));
+    if (!changed.length) {
+      // The document may still catch up after the message completes; stop waiting soon.
+      if (expiryRef.current === undefined) {
+        expiryRef.current = window.setTimeout(() => {
+          beforeRef.current = null;
+          expiryRef.current = undefined;
+        }, 3000);
+      }
+      return;
+    }
+    if (expiryRef.current !== undefined) {
+      window.clearTimeout(expiryRef.current);
+      expiryRef.current = undefined;
+    }
+    beforeRef.current = null;
+    setResults(changed.slice(-6));
+  }, [replyActive, nodes]);
+  useEffect(() => () => {
+    if (expiryRef.current !== undefined) window.clearTimeout(expiryRef.current);
+  }, []);
+  if (!visible || dismissed || !results.length) return null;
+  return (
+    <div className="cw-simple-results" role="region" aria-label={t("workMode.results.title")}>
+      <div className="cw-simple-results-head">
+        <strong>{t("workMode.results.title")}</strong>
+        <button
+          type="button"
+          className="cw-simple-results-dismiss"
+          aria-label={t("workMode.results.dismiss")}
+          onClick={() => setDismissed(true)}
+        >
+          ×
+        </button>
+      </div>
+      <div className="cw-simple-results-strip">
+        {results.map((node) => (
+          <div key={node.id} className="cw-simple-result" data-kind={node.type}>
+            <span className="cw-simple-result-title">{node.data.title}</span>
+            {onView && (
+              <button type="button" className="cw-simple-result-view" onClick={() => onView(node.id)}>
+                {t("workMode.results.view")}
+              </button>
+            )}
+          </div>
+        ))}
+      </div>
+    </div>
+  );
+}
