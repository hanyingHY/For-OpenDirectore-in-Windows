+}
+.cw-simple-mode .react-flow {
+  opacity: 0.18;
+  pointer-events: none;
+  transition: opacity 0.2s ease;
+}
+.cw-simple-mode .cw-assistant-panel {
+  left: 50%;
+  right: auto;
+  top: 78px;
+  bottom: 24px;
+  width: min(760px, calc(100% - 48px));
+  transform: translateX(-50%);
+}
+.cw-mode-toggle[aria-pressed="true"] {
+  color: var(--chat-text, inherit);
+  background: #ffffff14;
+}
diff --git a/src/canvas/workMode.ts b/src/canvas/workMode.ts
new file mode 100644
index 0000000..fb58c01
--- /dev/null
+++ b/src/canvas/workMode.ts
@@ -0,0 +1,29 @@
+import { useEffect, useState } from "react";
+
+/**
+ * Simple / advanced working mode (desktop.14 · A1). Simple puts the AI conversation in the
+ * centre and dims the canvas; advanced is the full canvas workflow. The choice is a local
+ * preference: switching never edits the project, and a running reply keeps running.
+ */
+export type WorkMode = "simple" | "advanced";
+const KEY = "opendirector.work-mode.v1";
+
+export function readWorkMode(): WorkMode {
+  try {
+    return localStorage.getItem(KEY) === "simple" ? "simple" : "advanced";
+  } catch {
+    return "advanced";
+  }
+}
+
+export function useWorkMode() {
+  const [mode, setMode] = useState<WorkMode>(readWorkMode);
+  useEffect(() => {
+    try {
+      localStorage.setItem(KEY, mode);
+    } catch {
+      /* Keep usable without storage. */
+    }
+  }, [mode]);
+  return [mode, setMode] as const;
+}
