diff --git a/src/canvas/workMode.ts b/src/canvas/workMode.ts
new file mode 100644
index 0000000..c9b7d32
--- /dev/null
+++ b/src/canvas/workMode.ts
@@ -0,0 +1,32 @@
+import { useState } from "react";
+
+/**
+ * Simple / advanced working mode (desktop.14 · A1). Simple puts the AI conversation in the
+ * centre and dims the canvas; advanced is the full canvas workflow. The choice is a local
+ * preference: switching never edits the project, and a running reply keeps running.
+ * `null` means the user has not chosen yet (A2 first-run picker).
+ */
+export type WorkMode = "simple" | "advanced";
+const KEY = "opendirector.work-mode.v1";
+
+export function readStoredWorkMode(): WorkMode | null {
+  try {
+    const value = localStorage.getItem(KEY);
+    return value === "simple" || value === "advanced" ? value : null;
+  } catch {
+    return null;
+  }
+}
+
+export function useWorkMode() {
+  const [stored, setStored] = useState<WorkMode | null>(readStoredWorkMode);
+  const choose = (next: WorkMode) => {
+    setStored(next);
+    try {
+      localStorage.setItem(KEY, next);
+    } catch {
+      /* Keep usable without storage. */
+    }
+  };
+  return { mode: stored ?? "advanced", choose, unchosen: stored === null } as const;
+}
