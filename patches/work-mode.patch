+/** First-run choice between simple and advanced (desktop.14 · A2). Non-modal: the canvas stays usable. Either choice is saved and can be changed later from the top bar. */
+export function WorkModePicker({ onChoose }: { onChoose: (mode: WorkMode) => void }) {
+  const { t } = useI18n();
+  return (
+    <section className="cw-work-mode-picker" role="region" aria-labelledby="work-mode-picker-title">
+      <div className="cw-work-mode-picker-card">
+        <h2 id="work-mode-picker-title">{t("workMode.picker.title")}</h2>
+        <p>{t("workMode.picker.hint")}</p>
+        <div className="cw-work-mode-picker-options">
+          <button type="button" className="cw-work-mode-option" onClick={() => onChoose("simple")}>
+            <strong>{t("workMode.picker.simple")}</strong>
+            <span>{t("workMode.picker.simpleHint")}</span>
+          </button>
+          <button type="button" className="cw-work-mode-option" onClick={() => onChoose("advanced")}>
+            <strong>{t("workMode.picker.advanced")}</strong>
+            <span>{t("workMode.picker.advancedHint")}</span>
+          </button>
+        </div>
+      </div>
+    </section>
+  );
+}
