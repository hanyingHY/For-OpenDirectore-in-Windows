@@ -0,0 +1,47 @@
+import { useEffect, useRef } from "react";
+import { useI18n } from "../i18n/I18nProvider";
+import type { WorkMode } from "./workMode";
+import "./work-mode.css";
+
+/** First-run choice between simple and advanced (desktop.14 · A2). Non-modal and parked in the
+ * bottom-left corner so it never blocks the canvas centre or the top tool area. A pointer press
+ * or Escape outside the card dismisses it for this session without writing a preference. Either
+ * explicit choice is saved and can be changed later from the top bar. */
+export function WorkModePicker({ onChoose, onDismiss }: { onChoose: (mode: WorkMode) => void; onDismiss: () => void }) {
+  const { t } = useI18n();
+  const cardRef = useRef<HTMLElement | null>(null);
+  useEffect(() => {
+    // Capture phase: the canvas workspace stops pointer-event propagation for its
+    // own panning logic, so a bubble-phase listener would miss presses on nodes.
+    const onPointerDown = (event: PointerEvent) => {
+      if (cardRef.current && event.target instanceof Node && !cardRef.current.contains(event.target)) onDismiss();
+    };
+    const onKeyDown = (event: KeyboardEvent) => {
+      if (event.key === "Escape") onDismiss();
+    };
+    document.addEventListener("pointerdown", onPointerDown, true);
+    document.addEventListener("keydown", onKeyDown, true);
+    return () => {
+      document.removeEventListener("pointerdown", onPointerDown, true);
+      document.removeEventListener("keydown", onKeyDown, true);
+    };
+  }, [onDismiss]);
+  return (
+    <section className="cw-work-mode-picker" role="region" aria-labelledby="work-mode-picker-title" ref={cardRef}>
+      <div className="cw-work-mode-picker-card">
+        <h2 id="work-mode-picker-title">{t("workMode.picker.title")}</h2>
+        <p>{t("workMode.picker.hint")}</p>
+        <div className="cw-work-mode-picker-options">
+          <button type="button" className="cw-work-mode-option" onClick={() => onChoose("simple")}>
+            <strong>{t("workMode.picker.simple")}</strong>
+            <span>{t("workMode.picker.simpleHint")}</span>
+          </button>
+          <button type="button" className="cw-work-mode-option" onClick={() => onChoose("advanced")}>
+            <strong>{t("workMode.picker.advanced")}</strong>
+            <span>{t("workMode.picker.advancedHint")}</span>
+          </button>
+        </div>
+      </div>
+    </section>
+  );
+}
